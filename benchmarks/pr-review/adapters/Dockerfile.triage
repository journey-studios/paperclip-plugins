ARG PR_TRIAGE_IMAGE
FROM ${PR_TRIAGE_IMAGE}

ARG REVIEWER_BASE_REVISION
LABEL org.journeystudios.benchmark.base-revision=${REVIEWER_BASE_REVISION}

USER root
ENV TIKTOKEN_CACHE_DIR=/opt/benchmark-tokenizers
# Tokenizer tables are public build dependencies, not network access during a review.
RUN python -c "import tiktoken; tiktoken.get_encoding('o200k_base'); tiktoken.get_encoding('cl100k_base')" \
    && chmod -R a+rX /opt/benchmark-tokenizers
USER triage
