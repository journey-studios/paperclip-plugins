+  parseMessage, serializeMessage, type JsonRpcRequest, type JsonRpcResponse,
+} from "../src/protocol.js";
+import { createTestHarness } from "../src/testing.js";
+import { startWorkerRpcHost } from "../src/worker-rpc-host.js";
+
+const companyId = "11111111-1111-4111-8111-111111111111";
+const otherCompanyId = "22222222-2222-4222-8222-222222222222";
+const projectId = "33333333-3333-4333-8333-333333333333";
+const issueId = "44444444-4444-4444-8444-444444444444";
+function manifest(read = true): PaperclipPluginManifestV1 {
+  return { id: "example.artifact-test", apiVersion: 1, version: "1.0.0", displayName: "Artifact Test",
+    description: "Artifact API tests", author: "Example", categories: ["ui"],
+    capabilities: read ? ["artifacts.read"] : [], entrypoints: { worker: "dist/worker.js" } };
+}
+function fixture(id: string, overrides: Partial<CompanyArtifact> = {}): CompanyArtifact {
+  return { id, source: "attachment", mediaKind: "image", title: "Launch board", previewText: null,
+    contentType: "image/png", contentPath: `/api/attachments/${id}/content`, openPath: null, downloadPath: null,
+    issue: { id: issueId, identifier: "ACME-1", title: "Launch" }, project: { id: projectId, name: "Example Project" },
+    createdByAgent: null, updatedAt: "2026-10-07T00:00:00.000Z", href: "/ACME/issues/ACME-1", ...overrides };
+}
+
+describe("artifact SDK host capability and invocation boundary", () => {
+  it("requires artifacts.read before touching the host service", async () => {
+    const list = vi.fn();
+    const handlers = createHostClientHandlers({ pluginId: manifest().id, capabilities: [],
+      services: { artifacts: { list } } as unknown as HostServices });
+    await expect(handlers["artifacts.list"]({ companyId }, { invocationScope: { companyId } }))
+      .rejects.toBeInstanceOf(CapabilityDeniedError);
+    expect(list).not.toHaveBeenCalled();
+  });
+
+  it("rejects absent, different, and expired company invocation scopes", async () => {
+    const list = vi.fn();
+    const handlers = createHostClientHandlers({ pluginId: manifest().id, capabilities: ["artifacts.read"],
+      services: { artifacts: { list } } as unknown as HostServices });
+    for (const context of [undefined, { invocationScope: { companyId: otherCompanyId } },
+      { invalidInvocationScope: true, invocationScope: { companyId } }]) {
+      await expect(handlers["artifacts.list"]({ companyId }, context))
+        .rejects.toBeInstanceOf(InvocationScopeDeniedError);
+    }
+    expect(list).not.toHaveBeenCalled();
+  });
+
+  it("passes the canonical filters and opaque cursor only in the authorized company", async () => {
+    const response = { artifacts: [fixture("attachment:one")], nextCursor: "opaque" };
+    const list = vi.fn(async () => response);
+    const handlers = createHostClientHandlers({ pluginId: manifest().id, capabilities: ["artifacts.read"],
+      services: { artifacts: { list } } as unknown as HostServices });
+    const input = { companyId, projectId, kind: "image" as const, q: "Launch", groupBy: "task" as const,
+      groupIssueId: issueId, limit: 25, cursor: "previous-opaque" };
+    await expect(handlers["artifacts.list"](input, { invocationScope: { companyId } })).resolves.toBe(response);
+    expect(list).toHaveBeenCalledWith(input);
+  });
+});
+
+describe("artifact SDK test harness", () => {
+  it("enforces capability and required company id", async () => {
+    const denied = createTestHarness({ manifest: manifest(false) });
+    await expect(denied.ctx.artifacts.list({ companyId })).rejects.toThrow("artifacts.read");
+    const allowed = createTestHarness({ manifest: manifest() });
+    await expect(allowed.ctx.artifacts.list({ companyId: "" })).rejects.toThrow("companyId is required");
+  });
+
+  it("isolates companies and combines kind, project and search filters with pagination", async () => {
+    const harness = createTestHarness({ manifest: manifest() });
+    harness.seed({ artifacts: [
+      { companyId, ...fixture("attachment:c") }, { companyId, ...fixture("attachment:b") },
+      { companyId, ...fixture("attachment:a", { mediaKind: "video" }) },
+      { companyId, ...fixture("attachment:other-project", { project: null }) },
+      { companyId: otherCompanyId, ...fixture("attachment:secret") },
+    ] });
+    const input = { companyId, kind: "image" as const, projectId, q: "launch", limit: 1 };
+    const first = await harness.ctx.artifacts.list(input);
+    expect(first.artifacts.map((row) => row.id)).toEqual(["attachment:c"]);
+    expect(first.nextCursor).toBeTruthy();
+    expect(first.artifacts[0]).not.toHaveProperty("companyId");
+    const second = await harness.ctx.artifacts.list({ ...input, cursor: first.nextCursor! });
