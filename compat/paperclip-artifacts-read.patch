+async function workerRoundTrip(read: boolean) {
+  const input = new PassThrough();
+  const output = new PassThrough();
+  const reader = createInterface({ input: output });
+  const requests: JsonRpcRequest[] = [];
+  const pending = new Map<string, (message: JsonRpcResponse) => void>();
+  const worker = startWorkerRpcHost({ stdin: input, stdout: output, plugin: definePlugin({
+    async setup(ctx) {
+      ctx.data.register("list", async (params) => ctx.artifacts.list({ companyId: String(params.companyId), kind: "image", limit: 2 }));
+    },
+  }) });
+  let nextId = 1;
+  const call = (method: string, params: unknown, scope = false) => {
+    const id = `host-${nextId++}`;
+    const result = new Promise<JsonRpcResponse>((resolve) => pending.set(id, resolve));
+    input.write(serializeMessage({ ...createRequest(method, params, id),
+      ...(scope ? { paperclipInvocation: { id: "invocation-one", scope: { companyId } } } : {}) }));
+    return result;
+  };
+  reader.on("line", (line) => {
+    const message = parseMessage(line);
+    if (isJsonRpcResponse(message)) {
+      pending.get(String(message.id))?.(message);
+      pending.delete(String(message.id));
+    } else if (isJsonRpcRequest(message)) {
+      requests.push(message);
+      input.write(serializeMessage(createSuccessResponse(message.id, { artifacts: [fixture("attachment:one")], nextCursor: null })));
+    }
+  });
+  try {
+    await call("initialize", { manifest: manifest(read), config: {}, databaseNamespace: null });
+    const response = await call("getData", { key: "list", companyId, params: { companyId } }, true);
+    return { response, requests };
+  } finally {
+    worker.stop(); reader.close(); input.destroy(); output.destroy();
+  }
+}
+
+describe("artifact worker client", () => {
+  it("rejects capability denial locally without issuing RPC", async () => {
+    const { response, requests } = await workerRoundTrip(false);
+    expect(response).toMatchObject({ error: { message: expect.stringContaining("artifacts.read") } });
+    expect(requests.filter((request) => request.method === "artifacts.list")).toEqual([]);
+  });
+
+  it("sends typed catalog options and preserves the host invocation id", async () => {
+    const { response, requests } = await workerRoundTrip(true);
+    expect(response).toMatchObject({ result: { artifacts: [{ id: "attachment:one" }], nextCursor: null } });
+    expect(requests.find((request) => request.method === "artifacts.list")).toMatchObject({
+      params: { companyId, kind: "image", limit: 2 }, paperclipInvocationId: "invocation-one",
+    });
+  });
+});
