@@ -0,0 +1,207 @@
+import { createInterface } from "node:readline";
+import { PassThrough } from "node:stream";
+import { describe, expect, it, vi } from "vitest";
+import type { CompanyArtifact, PaperclipPluginManifestV1 } from "@paperclipai/shared";
