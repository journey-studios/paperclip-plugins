+/** Declarative publication only; human identity and buttons are host-owned. */
+export type NativeDecisionRef = { kind: 'approval'; id: string } | { kind: 'interaction'; id: string; issueId: string };
+export interface NativeDecisionCardInput {
+  decision: NativeDecisionRef;
+  destinationConversationId: string;
+  expectedRevision: string;
+}
+export type NativeDecisionCardContextInput = { decision: NativeDecisionRef } & (
+  { destinationConversationId: string; destinationIssueId?: never } |
+  { destinationIssueId: string; destinationConversationId?: never }
+);
+export interface NativeDecisionCardContext { destinationConversationId: string; expectedRevision: string; status: string; eligible: boolean }
+export interface NativeDecisionCardResult { cardId: string; linkOnly: boolean }
+export interface NativeDecisionPublication {
+  version: 1; cardId: string; effectKey: string;
+  kind: 'publish_card' | 'replace_card' | 'request_reason'; promptId?: string;
+}
