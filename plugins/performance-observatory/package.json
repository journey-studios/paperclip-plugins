{
  "name": "@journey-studios/performance-observatory",
  "version": "0.1.2",
  "type": "module",
  "license": "MIT",
  "description": "On-demand and scheduled performance reviews with private environment-scoped history",
  "files": [
    "dist",
    "migrations",
    "README.md",
    "bin"
  ],
  "scripts": {
    "build": "node esbuild.config.mjs",
    "test": "node --test test/*.spec.mjs",
    "type-check": "tsc --noEmit",
    "typecheck": "pnpm type-check"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "dependencies": {
    "echarts": "6.0.0",
    "echarts-for-react": "3.0.6"
  },
  "devDependencies": {
    "@paperclipai/plugin-sdk": "workspace:*",
    "@electric-sql/pglite": "0.3.15"
  },
  "bin": {
    "performance": "./bin/performance.mjs"
  }
}
