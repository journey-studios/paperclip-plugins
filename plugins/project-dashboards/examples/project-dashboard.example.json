  "sections": [
    {
      "id": "overview",
      "title": "Overview",
      "note": "Headline numbers across the whole program.",
      "blocks": [
        {
          "type": "kpis",
          "items": [
            {
              "label": "Phases done",
              "value": {
                "dataset": "phases",
                "field": "phase",
                "where": {
                  "status": "done"
                },
                "agg": "count"
              },
              "of": {
                "dataset": "phases",
                "field": "phase",
                "agg": "count"
              },
              "caption": "Gates passed so far",
              "format": "int"
            },
            {
              "label": "Roadmap boxes",
              "value": {
                "dataset": "roadmap",
                "field": "done",
                "agg": "sum"
              },
              "of": {
                "dataset": "roadmap",
                "field": "total",
                "agg": "sum"
              },
              "caption": "Done versus still open",
              "format": "int"
            },
            {
              "label": "Open P0 items",
              "value": {
                "dataset": "pending",
                "field": "id",
                "where": {
                  "priority": "P0"
                },
                "agg": "count"
              },
              "tone": "bad",
              "caption": "Need attention first",
              "format": "int"
            },
            {
              "label": "Shipped this week",
              "value": {
                "dataset": "deliveries",
                "field": "shipped",
                "agg": "sum"
              },
              "caption": "Seven-day total",
              "format": "int"
            },
            {
              "label": "Line coverage",
              "value": {
                "dataset": "coverage",
                "field": "value",
                "where": {
                  "gate": "Line coverage"
                }
              },
              "format": "pct",
              "caption": "Target 80%"
            }
          ]
        }
      ]
    },
    {
      "id": "phases",
      "title": "Phases and gates",
      "note": "Each gate is **ok** when the phase exit criteria are met.",
      "columns": 2,
      "blocks": [
        {
          "type": "table",
          "title": "Phases",
          "dataset": "phases",
          "rowKey": "phase",
          "span": 2,
          "columns": [
            {
              "field": "phase",
              "label": "Phase",
              "format": "strong"
            },
            {
              "field": "name",
              "label": "Name"
            },
            {
              "field": "scope",
              "label": "Scope",
              "wide": true
            },
            {
              "field": "status",
              "label": "Status",
              "format": "status"
            }
          ]
        },
        {
          "type": "chart",
          "title": "Roadmap boxes",
          "note": "Done and open items per phase.",
          "chart": "stackedBar",
          "dataset": "roadmap",
          "x": "phase",
          "y": [
            "done",
            "open"
          ],
          "seriesLabels": {
            "done": "Done",
            "open": "Open"
          },
          "format": "int"
        },
        {
          "type": "mermaid",
          "title": "Phase flow",
          "code": "flowchart LR\n  F0[Foundations] --> F1[Core accounts]\n  F1 --> F2[Billing]\n  F2 --> F3[Public API]\n  F3 --> F4[Launch readiness]"
        }
      ]
    },
    {
      "id": "production",
      "title": "What exists in production",
      "note": "Live services and their health.",
      "blocks": [
        {
          "type": "statusList",
          "dataset": "production",
          "labelField": "name",
          "valueField": "value",
          "statusField": "status",
          "detailField": "note"
        }
      ]
    },
    {
      "id": "pending",
      "title": "Pending items",
      "note": "Filter by status, type or search by text.",
      "blocks": [
        {
          "type": "table",
          "dataset": "pending",
          "rowKey": "id",
          "columns": [
            {
              "field": "id",
              "label": "ID",
              "format": "code"
            },
            {
              "field": "title",
              "label": "Title",
              "wide": true
            },
            {
              "field": "type",
              "label": "Type",
              "format": "muted"
            },
            {
              "field": "priority",
              "label": "Priority",
              "format": "priority"
            },
            {
              "field": "status",
              "label": "Status",
              "format": "status"
            },
            {
              "field": "owner",
              "label": "Owner"
            }
          ],
          "filters": {
            "chips": "status",
            "selects": [
              "type",
              "priority"
            ],
            "search": true
          },
          "sort": {
            "field": "priority",
            "dir": "asc"
          },
          "emptyText": "Nothing matches these filters."
        },
        {
          "type": "chart",
          "title": "Pending by type and priority",
          "chart": "stackedBar",
          "dataset": "pending_by_type",
          "x": "type",
          "y": [
            "P0",
            "P1",
            "P2"
          ],
          "format": "int"
        }
      ]
    },
    {
      "id": "delivery",
      "title": "Delivery",
      "columns": 2,
      "blocks": [
        {
          "type": "chart",
          "title": "Deliveries per day",
          "chart": "bar",
          "dataset": "deliveries",
          "x": "day",
          "y": "shipped",
          "seriesLabels": {
            "shipped": "Shipped"
          },
          "format": "int",
          "goal": 4
        },
        {
          "type": "table",
          "title": "Recent releases",
          "dataset": "releases",
          "rowKey": "version",
          "columns": [
            {
              "field": "date",
              "label": "Date",
              "format": "date"
            },
            {
              "field": "version",
              "label": "Version",
              "format": "code"
            },
            {
              "field": "summary",
              "label": "Summary",
              "wide": true
            },
            {
              "field": "link",
              "label": "Notes",
              "format": "link"
            }
          ]
        },
        {
          "type": "chart",
          "title": "Code size by module",
          "chart": "horizontalBar",
          "dataset": "code",
          "x": "module",
          "y": "lines",
          "seriesLabels": {
            "lines": "Lines"
          },
          "format": "int"
        },
        {
          "type": "chart",
          "title": "Quality gates",
          "chart": "progress",
          "dataset": "coverage",
          "x": "gate",
          "y": "value",
          "format": "pct",
          "goal": 1
        }
      ]
    },
    {
      "id": "limits",
      "title": "What this dashboard does not prove",
      "blocks": [
        {
          "type": "callout",
          "tone": "warn",
          "content": "All figures are **demo data** and are only as fresh as the *updated* time of each source."
        },
        {
          "type": "markdown",
          "content": "- A passing gate shows the criteria were met, not that users are satisfied.\n- Uptime comes from synthetic checks, not from real traffic.\n- Line counts measure size, not quality or risk.\n- Coverage numbers do not show that the right behavior is tested."
        }
      ]
    }
  ]
}
