{
  "name": "@journey-studios/paperclip-plugin-project-hierarchy",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Sub-projects for Paperclip: nest projects under a parent project without changing Paperclip core",
  "license": "MIT",
  "engines": {
    "node": ">=24.11.0"
  },
  "files": [
    "dist",
    "migrations",
    "README.md"
  ],
  "scripts": {
    "build": "node esbuild.config.mjs",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "dependencies": {},
  "devDependencies": {
    "@electric-sql/pglite": "0.3.15",
    "@paperclipai/plugin-sdk": "workspace:*",
    "@paperclipai/shared": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
