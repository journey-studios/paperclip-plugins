[Unit]
Description=Read-only Journey Studios Paperclip storage metrics collection
Documentation=https://github.com/journey-studios/paperclip-plugins/tree/main/services/storage-collector
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0022
Environment=STORAGE_OUTPUT_DIR=/var/lib/paperclip-storage-manager
EnvironmentFile=-/etc/paperclip-storage-manager.env
ExecStart=/usr/bin/node /opt/paperclip-storage-collector/src/collect.mjs
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/paperclip-storage-manager
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
TimeoutStartSec=240
